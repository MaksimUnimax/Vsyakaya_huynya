{
  "manifest_version": 3,
  "name": "Polymarket Bridge — ChatGPT ↔ Polymarket",
  "version": "0.1.3",
  "description": "Read-only research bridge from ChatGPT code-block commands to public Polymarket APIs, with chunked JSON file delivery, validated Send, and paused failure/stale-outbox safety.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gamma-api.polymarket.com/*",
    "https://clob.polymarket.com/*",
    "https://data-api.polymarket.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "product.js",
        "conversation_identity.js",
        "composer_send.js",
        "protocol.js",
        "delivery_policy.js",
        "chatgpt_file_attachment.js",
        "content_script.js",
        "file_delivery_content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Polymarket Bridge",
    "default_popup": "popup.html"
  }
}
